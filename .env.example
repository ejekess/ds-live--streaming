# 环境变量示例：复制成 .env 后按需填写（程序启动时会自动读取 .env）

# —— 大模型（可选，默认不用）——
# 只有把 config/config.json 的 brain.kind 改成 "llm"、brain.llm.enabled 改成 true，
# 并且这里配了 Key，才会真的发请求。
# 安全边界见 src/brain/guard.mjs：输入限长、注入粗筛、输出限长、每分钟/每天调用上限、硬超时。
DEEPSEEK_API_KEY=sk-put-your-key-here

# —— 日志级别 ——
# debug / info / warn / error
LOG_LEVEL=info
